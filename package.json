{
  "name": "claude-usagement",
  "version": "1.0.0",
  "description": "Always-on-top desktop widget showing your Claude plan usage in real time",
  "productName": "Claude Usagement",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.claude.usagement",
    "productName": "Claude Usagement",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.ico"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "ClaudeUsagement-portable.exe"
    }
  }
}
